    "build": "next build --webpack",
    "start": "next start",
    "audit:catalog": "node scripts/audit-tool-catalog.mjs",
    "lint": "eslint",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:prepare": "node scripts/prepare-desktop.mjs",
    "landing:build": "node landing-src/build.mjs",
    "landing:serve": "node scripts/serve-site.mjs",
    "landing:deploy": "wrangler pages deploy landing --project-name openfoundry --branch main",
    "tauri": "tauri",
    "test": "vitest run"
  },
  "dependencies": {
    "@fluentui/react-icons": "^2.0.345",
    "@xyflow/react": "^12.12.1",
    "cron-parser": "^5.10.3",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@fluentui/react-components": "^9.75.0",
    "@tailwindcss/turbopack": "^4",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.25.12",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
