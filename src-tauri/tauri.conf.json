{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "openFoundry",
  "version": "0.1.0",
  "identifier": "app.openfoundry.desktop",
  "build": {
    "beforeDevCommand": "npm run dev -- -p 1420",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && npm run desktop:prepare",
    "frontendDist": "loading"
  },
  "app": {
    "windows": [
      {
        "title": "openFoundry",
        "width": 1440,
        "height": 900,
        "minWidth": 1040,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "A local AI workbench for models, agents and knowledge.",
    "longDescription": "openFoundry is an independent, free desktop workbench for running local AI models, prompt agents and knowledge tools on your own computer.",
    "resources": [
      "next-server",
      "resources"
    ],
    "macOS": {
      "minimumSystemVersion": "13.5",
      "signingIdentity": "-"
    }
  }
}
